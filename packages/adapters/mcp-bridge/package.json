{
  "name": "@tangent-forge/paperclip-mcp-adapter",
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://github.com/Tangent-Forge/paperclip",
  "bugs": {
    "url": "https://github.com/Tangent-Forge/paperclip/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tangent-Forge/paperclip.git",
    "directory": "packages/adapters/mcp-bridge"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:dist": "pnpm run build && node tests/dist-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@paperclipai/adapter-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
